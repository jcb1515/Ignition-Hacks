# ---- Runway Radar -------------------------------------------------------
# Copy to .env.local. Everything below is optional: with no keys at all the
# app runs fully in demo mode against seeded data and never touches the network.

# Demo mode (default true). Agents use deterministic templates, no external
# calls. Set to "false" to enable the NVIDIA LLM, Plaid/Stripe sync, and search.
DEMO_MODE=true

# Dollar impact above which the Orchestrator pauses for human approval.
APPROVAL_THRESHOLD=1000

# SQLite file location (default ./runway.db)
# DATABASE_PATH=./runway.db

# ---- LLM (NVIDIA NIM, OpenAI-compatible) --------------------------------
NVIDIA_API_KEY=
# NVIDIA_API_KEY_BACKUP=
# NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731
# NVIDIA_MODEL_BACKUP=google/gemma-4-31b-it
# LLM_TIMEOUT_MS=20000

# ---- Plaid (SANDBOX ONLY — base URL is hard-coded to sandbox.plaid.com) -
PLAID_CLIENT_ID=
PLAID_SECRET=
# PLAID_INSTITUTION_ID=ins_109508     # First Platypus Bank (sandbox default)
# PLAID_ACCESS_TOKEN=                 # reuse an Item instead of creating one per sync

# ---- Stripe (TEST MODE ONLY — non sk_test_ keys are refused in code) ----
STRIPE_SECRET_KEY=sk_test_

# ---- Negotiator contact lookup (Tavily web search; optional) ------------
SEARCH_API_KEY=

# ---- Mailtrap sandbox SMTP (drafts are caught here, never delivered) ----
# Only sandbox hosts are accepted by lib/mailer.ts.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=finance@northwindlabs.test
